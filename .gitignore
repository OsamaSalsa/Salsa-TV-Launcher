# ==============================================================================
# GitHub Export Filter — Release, Screenshots, README & OTA Auto-Update Only
# Excludes all internal source code, Gradle files, configs, and build artifacts.
# ==============================================================================

# Ignore everything in root by default
/*

# Explicitly ignore all internal source code, Gradle, config, and build paths
/app/
/gradle/
/public/
/.aistudio/
/.gradle/
/.kotlin/
/.idea/
/build/
/captures/
/.externalNativeBuild/
/.cxx/
/.build-outputs/
/workspace/
/build.gradle.kts
/settings.gradle.kts
/gradle.properties
/local.properties
/metadata.json
/.env
/.env.example
/debug.keystore
/debug.keystore.base64
*.iml

# Allow ONLY README files, screenshots, release APK, and OTA auto-update files
!/.gitignore
!/README.md
!/README_*.md
!/docs/
/docs/*
!/docs/screenshots/
!/docs/screenshots/**
!/kids_themes/
!/kids_themes/**
!/screenshots/
!/screenshots/**
!/salsa-tv-launcher.apk
!/version.json

# Always ignore OS junk files anywhere
.DS_Store
